{
  "name": "pulsar-launcher",
  "productName": "Pulsar Client",
  "version": "0.9.5",
  "description": "Launcher do Pulsar Client, focado em PVP no Minecraft 1.8.9",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node ../instalador/compilar.js atualizador && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "minecraft-launcher-core": "3.18.2",
    "msmc": "5.0.5",
    "adm-zip": "0.5.16",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.pulsarclient.launcher",
    "productName": "Pulsar Client",
    "files": [
      "main.js",
      "preload.js",
      "console-preload.js",
      "gravador-preload.js",
      "lib/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "../mod/build/libs",
        "to": "mods",
        "filter": [
          "pulsar-client-*.jar",
          "!*-sources.jar",
          "!*-dev.jar"
        ]
      },
      {
        "from": "../mod/build/anterior",
        "to": "anterior",
        "filter": [
          "pulsar-client-*.jar"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "build/atualizador",
          "to": "atualizador",
          "filter": [
            "PulsarAtualizador.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "R0N1234",
        "repo": "Pulsar_Client",
        "private": true,
        "releaseType": "release"
      }
    ]
  }
}
