{
  "name": "pulsar-launcher",
  "productName": "Pulsar Client",
  "version": "0.2.0",
  "description": "Launcher do Pulsar Client, focado em PVP no Minecraft 1.8.9",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "minecraft-launcher-core": "3.18.2",
    "msmc": "5.0.5",
    "adm-zip": "0.5.16",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.pulsarclient.launcher",
    "productName": "Pulsar Client",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "../mod/build/libs",
        "to": "mods",
        "filter": [
          "pulsar-client-*.jar",
          "!*-sources.jar",
          "!*-dev.jar"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "R0N1234",
        "repo": "Pulsar_Client-releases",
        "releaseType": "release"
      }
    ]
  }
}
